# Copy to .env to change settings. Every name starts with PROFILE_.
# public is the only mode that may be deployed. local enables features that use files derived from the real data.
PROFILE_APP_MODE=public
PROFILE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Only valid in local mode. Folder with artifacts derived from the real data (never committed).
# PROFILE_TIER1_ARTIFACT_DIR=artifacts/tier1

# Rate limiting, per client address and per minute. Searches (and classifier runs) have their own, lower limit.
# PROFILE_RATE_LIMIT_ENABLED=true
# PROFILE_RATE_LIMIT_SEARCH_PER_MINUTE=30
# PROFILE_RATE_LIMIT_GENERAL_PER_MINUTE=240
# Only behind a reverse proxy you control: use the last X-Forwarded-For entry as the client address.
# PROFILE_TRUST_PROXY=false
# In public mode origins must be https (localhost is allowed for development). A wildcard is refused.
