# syntax=docker/dockerfile:1.7
#
# The image Render builds from the Git repository (Free plan: 512 MB of memory, 0.1 CPU). Build context = the repository
# root (see ../../.dockerignore). Local test, from a clean copy of the repository:
#     docker build -f app/deploy/Dockerfile.render -t profile-intelligence:render .
#
# What this image holds is decided by an allowlist, not by what happens to be in the repository: stage 2 runs
# app/backend/scripts/make_deploy_bundle.py, which copies only the listed files and refuses the build if one of them is
# a data file, a model or index file, an environment file, a notebook, a Tier 1 file, a local path or a secret. Only the
# bundle reaches the final image. No real profile, notebook, classifier or credential can be in it.
#
# Memory: the application needs about 400 MB when running. To stay under 512 MB it
#   * serves with the "lean" encoder (transformers only, no sentence_transformers package: same vectors, bit for bit),
#   * has pandas removed (nothing serving needs it; scikit-learn only imports it when it is there),
#   * uses one PyTorch thread and at most two searches at a time (the vectors do not depend on the thread count).

# ------------------------------------------------------------ 1. the web application
FROM node:26-bookworm-slim AS web
WORKDIR /web
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app/frontend ./
RUN npm run build

# ------------------------------------------------------------ 2. the allowlisted bundle
FROM python:3.12-slim-bookworm AS bundle
COPY app /repo/app
COPY --from=web /web/dist /repo/app/frontend/dist
RUN python /repo/app/backend/scripts/make_deploy_bundle.py --root /repo --out /bundle

# ------------------------------------------------------------ 3. python environment, model and search index
FROM python:3.12-slim-bookworm AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 HF_HOME=/opt/hf PROFILE_ARTIFACT_DIR=/opt/artifacts
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY --from=bundle /bundle/backend/requirements.txt /tmp/requirements.txt
# CPU only PyTorch: the default Linux wheel carries about 2 GB of CUDA libraries this application never uses.
RUN pip install torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r /tmp/requirements.txt \
 && pip uninstall -y pandas
COPY --from=bundle /bundle/backend /app/backend
COPY --from=bundle /bundle/content /app/content
# The index is built here, on the platform that will serve it, with the package's own encode (the notebook's call).
RUN python /app/backend/scripts/download_model.py \
 && python /app/backend/scripts/build_search_index.py \
 && chmod -R a+rX /opt/hf /opt/artifacts

# ------------------------------------------------------------ 4. runtime
FROM python:3.12-slim-bookworm
RUN useradd --system --uid 1000 --home-dir /nonexistent --shell /usr/sbin/nologin app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/hf /opt/hf
COPY --from=build /opt/artifacts /opt/artifacts
COPY --from=bundle /bundle/backend /app/backend
COPY --from=bundle /bundle/content /app/content
COPY --from=bundle /bundle/frontend/dist /app/frontend/dist
COPY --from=bundle /bundle/BUNDLE_MANIFEST.json /app/BUNDLE_MANIFEST.json

# Public mode only. Offline: the model is in the image and nothing is fetched at run time.
# Render sets PORT (10000 by default) and sends the client address in X-Forwarded-For.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 MALLOC_ARENA_MAX=2 \
    PROFILE_APP_MODE=public \
    PROFILE_ARTIFACT_DIR=/opt/artifacts \
    PROFILE_STATIC_DIR=/app/frontend/dist \
    PROFILE_TRUST_PROXY=true \
    PROFILE_TORCH_THREADS=1 \
    PROFILE_MAX_CONCURRENT_SEARCHES=2 \
    PORT=10000
WORKDIR /app/backend
USER 1000
EXPOSE 10000

# One worker: the models are loaded once, and the rate limiter counts in one place.
CMD ["sh", "-c", "exec uvicorn profile_api.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --no-server-header --no-access-log"]
